{
    # Global options
    auto_https disable_redirects
}

# Plain HTTP: serves the application and the Mercure hub.
# http://localhost:8180
:80 {
    root * /app/public
    encode gzip

    # Bounded proxy-level abuse posture (partial; see README and ADR 0003).
    # Mercure is excluded from write timeouts because it is a long-lived SSE stream.
    @notMercure {
        not path /.well-known/mercure*
    }
    request_body {
        max_size 1MB
    }
    timeouts @notMercure {
        read_timeout 10s
        write_timeout 30s
        max_write_chunk 16KiB
    }

    # History-mode SPA routes: render the Twig shell for extensionless client-side
    # paths, while leaving API, build assets, Mercure and real files untouched.
    @spa {
        not path /api/* /build/* /.well-known/mercure*
        not file
    }
    route @spa {
        rewrite /index.php/
        php {
            env REQUEST_URI /index.php
        }
    }

    # Mercure hub
    mercure {
        protocol_version_compatibility 8
        publisher_jwt {env.MERCURE_JWT_SECRET}!ChangeThisMercureHubJWTSecretKey!
        subscriber_jwt {env.MERCURE_JWT_SECRET}!ChangeThisMercureHubJWTSecretKey!
        anonymous
        cors_origins *
    }

    php_server
    file_server
}

# HTTPS with a locally-trusted certificate, proxied to the HTTP site.
# https://localhost:8443
localhost:443, 127.0.0.1:443 {
    tls internal
    reverse_proxy 127.0.0.1:80
}
